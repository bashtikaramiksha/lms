# =================================================================
# LMS Platform — Environment Variables
# Copy this file to .env.local and fill in the values
# =================================================================

# Environment Mode: development | production | test
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────
# 1. NextAuth.js v5 Configuration
# ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=local-development-auth-secret-change-in-production-min-32-chars
AUTH_URL=http://localhost:3000

# Google OAuth Credentials (console.cloud.google.com)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth Credentials (Optional)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ─────────────────────────────────────────────────────────────────
# 2. Database — Turso / libSQL (Local SQLite fallback supported)
# ─────────────────────────────────────────────────────────────────
# For Local SQLite: file:./local.db (Requires NO auth token)
# For Turso Cloud: libsql://your-db-name.turso.io
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────────
# 3. Email Service — Resend (resend.com)
# ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# ─────────────────────────────────────────────────────────────────
# 4. Storage — AWS S3 / Cloudflare R2
# ─────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=lms-platform-media

# ─────────────────────────────────────────────────────────────────
# 5. Background Jobs — Inngest (inngest.com)
# ─────────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─────────────────────────────────────────────────────────────────
# 6. Rate Limiting — Upstash Redis (upstash.com)
# ─────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────────
# 7. Payments — Stripe & Razorpay
# ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
